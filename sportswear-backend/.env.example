# 服务器配置
SERVER_PORT=8080
SERVER_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sportswear_platform
DB_SSLMODE=disable

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24
JWT_IDLE_TIMEOUT=8

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sportswear
MINIO_USE_SSL=false

# 上传限制
MAX_UPLOAD_SIZE=20

# 默认管理员
ADMIN_EMAIL=admin@sportswear.com
ADMIN_PASSWORD=Admin@123456

# 邮件服务（SMTP）
# 配置后新询盘会自动发送邮件通知到所有管理员
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Sportswear Platform
SMTP_FROM_EMAIL=

# 后台管理地址（邮件通知中的链接）
ADMIN_URL=http://localhost:5173